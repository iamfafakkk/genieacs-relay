# Copy to .env. All optional.

# Base URL of the Go backend. Leave unset in dev to use the Vite proxy.
# Set this (e.g. http://localhost:9898) when the backend runs on another host/port.
# VITE_API_BASE_URL=http://localhost:9898

# Dev proxy target — must match SERVER_ADDR in the repo's .env (default :8080).
VITE_API_PROXY_TARGET=http://localhost:9898
